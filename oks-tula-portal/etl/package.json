{
  "name": "@oks/etl",
  "version": "0.1.0",
  "private": true,
  "description": "ETL: нормализация objects.csv → PostgreSQL/PostGIS, отчёт о качестве данных, геокодинг-очередь (§6 ТЗ)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
