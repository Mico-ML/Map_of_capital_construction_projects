{
  "name": "@oks/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API портала ОКС Тульской области: данные, прокси 2ГИС, метрики, жалобы, медиа (§11 ТЗ)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && tsc -p tsconfig.seed.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "test": "vitest run --root ../.."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@oks/etl": "*",
    "@oks/shared": "*",
    "@prisma/client": "^6.16.2",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "prisma": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.16.10",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
